#!/bin/sh
# dev-loop pre-push hook for this repo — install: cp dev/hooks/pre-push .git/hooks/pre-push
# (LF endings, no extension; a worktree shares the main checkout's hooks). Tracked here on
# dev, never shipped (dev/ is stripped at release). Override the main guard: ALLOW_MAIN_PUSH=1.
#
#   main  — blocked outright (release = PR from a release/* branch).
#   dev   — the three fast zero-dep doc gates run before publishing.
#   EVERY ref (the default arm, F-423) — the instance-data gate runs, because tester verdict
#           rounds land on feature branches and bus prose is where tenant identifiers
#           accumulate; a leak pushed to any ref is irreversible in the same way. The
#           checker resolves its private-pattern config from the main checkout when run
#           from a worktree and warns on its own line when no private pattern loaded.
#
# The gates run over the TREE BEING PUSHED, never over the checkout the hook happens to
# run in (F-584): each pushed commit is checked out into a temporary worktree and the
# gate scripts of THAT tree run there, so a push of a branch other than the checked-out
# one, a push of several refs, or a push from a clean checkout of a branch another
# worktree holds, is judged on what the push carries. The checker finds the main
# checkout's private config through the common git dir (F-423) and inherits
# PRIVATE_INSTANCE_PATTERNS from this shell. A pushed tree that predates the gate scripts
# is gated with this checkout's checker over this checkout, and the hook says so.
# Skip everything with: git push --no-verify (say so on the bus).
#
# git exports GIT_DIR (and sometimes GIT_INDEX_FILE / GIT_WORK_TREE) to hooks; a git
# command run in the temporary worktree would then read THIS checkout's index. Clear them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

ZERO=0000000000000000000000000000000000000000

# gate_tree <sha> <label> <arm>: check out <sha> into a temporary worktree and run the
# gates there — <arm> "dev" runs the three doc gates, anything else the instance-data
# gate alone. Returns non-zero when a gate fails; always removes the worktree.
gate_tree() {
  sha=$1; label=$2; arm=$3; rc=0
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/gacd-prepush-XXXXXX") || { echo "pre-push: could not create a temporary directory for the gate" >&2; return 1; }
  if ! git worktree add -q --detach "$tmp" "$sha" >/dev/null 2>&1; then
    echo "pre-push: could not check out $sha ($label) into a temporary worktree" >&2
    rmdir "$tmp" 2>/dev/null
    return 1
  fi
  if [ ! -f "$tmp/build/check-instance-data.mjs" ]; then
    echo "pre-push: $label ($sha) carries no build/check-instance-data.mjs — gating it with this checkout's checker over THIS checkout, not the pushed tree" >&2
    node build/check-instance-data.mjs >&2 || rc=1
  else
    if [ "$arm" = dev ]; then
      node "$tmp/build/check-doc-drift.mjs" >&2 || { echo "pre-push: check-doc-drift failed on $label — fix or push --no-verify" >&2; rc=1; }
      [ $rc -eq 0 ] && { node "$tmp/build/check-stale-facts.mjs" >&2 || { echo "pre-push: check-stale-facts failed on $label — fix or push --no-verify" >&2; rc=1; }; }
    fi
    [ $rc -eq 0 ] && { node "$tmp/build/check-instance-data.mjs" >&2 || { echo "pre-push: check-instance-data failed on $label ($sha) — redact, then push again (or --no-verify and say so on the bus)" >&2; rc=1; }; }
  fi
  git worktree remove --force "$tmp" >/dev/null 2>&1 || rm -rf "$tmp"
  return $rc
}

while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      # The override lifts THIS guard only — the instance-data gate below still runs for
      # every other ref in the same push (release-gate review of 0.37.0, F-435).
      [ "$ALLOW_MAIN_PUSH" = "1" ] && continue
      echo "pre-push: direct push to main blocked (dev-loop). PR from dev instead, or ALLOW_MAIN_PUSH=1." >&2
      exit 1;;
  esac
  # A deletion pushes no tree; nothing to gate.
  [ "$local_sha" = "$ZERO" ] && continue
  case "$remote_ref" in
    refs/heads/dev)
      echo "pre-push: running fast checks on the pushed dev tree ($local_sha) before publishing..." >&2
      gate_tree "$local_sha" "$remote_ref" dev || exit 1
      ;;
    *)
      echo "pre-push: instance-data gate on the pushed tree of $remote_ref ($local_sha) (F-423: every ref; F-584: the pushed tree)..." >&2
      gate_tree "$local_sha" "$remote_ref" other || exit 1
      ;;
  esac
done
exit 0
