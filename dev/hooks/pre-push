#!/bin/sh
# dev-loop pre-push hook for this repo — install: cp dev/hooks/pre-push .git/hooks/pre-push
# (LF endings, no extension; a worktree shares the main checkout's hooks). Tracked here on
# dev, never shipped (dev/ is stripped at release). Override the main guard: ALLOW_MAIN_PUSH=1.
#
#   main  — blocked outright (release = PR from a release/* branch); with the override the
#           push proceeds but main's tree still goes through the instance-data gate.
#   dev   — the two fast zero-dep doc gates (check-doc-drift, check-stale-facts) run on the
#           pushed tip before publishing, then the instance-data gate like every ref.
#   EVERY ref (the default arm, F-423) — the instance-data gate runs, because tester verdict
#           rounds land on feature branches and bus prose is where tenant identifiers
#           accumulate; a leak pushed to any ref is irreversible in the same way. The
#           checker resolves its private-pattern config from the main checkout when run
#           from a worktree and warns on its own line when no private pattern loaded.
#
# WHAT IS GATED (F-584, F-588; the claim is written at the strength the code delivers):
#   The gates run over the TREES BEING PUSHED, never over the checkout the hook runs in.
#   Which commits a push publishes is read from the RECEIVING remote itself, never from
#   this clone's belief about it: `git ls-remote --heads --tags <push url>` (the URL git
#   hands the hook as $2 — the push URL, which can differ from the fetch URL) lists the
#   branch and tag tips the remote holds at push time, and every commit reachable from a
#   pushed tip that is reachable from none of those is checked out into a temporary
#   worktree and gated, oldest first. The tip is gated in any case, with its arm's full gate
#   set (so a new branch name over commits the remote already holds still has its tree
#   judged once); every earlier new commit gets the instance-data gate alone, because a leak
#   in an intermediate commit reaches the remote's history just the same. Tracking refs
#   (refs/remotes/*) play no part: a stale one, or another remote's, cannot shrink the set.
#   Replacement refs (git replace) are ignored, so the tree gated is the object pushed (a
#   deprecated .git/info/grafts file is not ignored by git's switch and still shapes the
#   history walked).
#   BESIDE EACH TREE (F-588), what the push publishes that is no tree: every gated commit's
#   MESSAGE (every check) and its author and committer names and addresses (the private
#   patterns alone: an address is an email by design); every annotated tag object a pushed
#   ref carries — a tag of a tag is peeled object by object — its body (every check,
#   a signature block included) and its header (the private patterns: the name stored in
#   the object and the tagger); and every pushed ref's NAME, gated FIRST, before this hook
#   prints it anywhere — a private hit refuses the push with the name unprinted. The
#   checker masks every PRIVATE string out of what it prints; a GENERIC hit (a tenant URL,
#   an email) prints its matched text as the checker does on any file, on the pusher's own
#   terminal. A refusal on the name or a tag says so, or that the checker could not run
#   (no private pattern under REQUIRE, an invalid pattern): the checker's own lines above
#   it say which.
#   FAIL CLOSED: when the set cannot be established the push is refused and the
#   message says how to recover. The remote's refs cannot be read (offline, auth): check the
#   connection and push again. The remote holds a branch or tag tip this clone has not
#   fetched (another clone pushed, or the PR page's "Update branch" merged, and this one
#   then pushes --force): `git fetch --tags <remote>`, then push again. A pushed ref does
#   not point at a commit (a tag of a blob): there is no tree to check out. The checker
#   cannot be staged, a worktree cannot be created, or a commit's message, identities or
#   tag object cannot be read: refused, never skipped.
#   STATED LIMITS: (1) only branch and tag tips count as held, so a commit the remote has
#   under another ref kind alone (GitHub's refs/pull/*) is gated again — more gating, never
#   less. (2) A remote with no refs yet gates the whole history; a clone whose fetch refspec
#   omits branches the remote has (--single-branch) is refused until it fetches them once
#   (`git fetch <remote> <sha>` fetches an advertised tip); a remote tag whose target a
#   plain fetch did not bring (a tag of a blob) is refused the same way until `--tags`. (3) A
#   shallow clone's cut history can make a commit look new that the remote holds — more
#   gating. (4) The remote is read once, at the start of the push; a change landing there in
#   the same moment is not seen — an addition only widens what counts as held (more gating),
#   while a deletion or forced update in that moment can leave a commit counted as held that
#   the remote no longer references, so this push would republish it ungated. (5) The judge is
#   the instance-data checker of the checkout the push runs from, AS ITS WORKING TREE
#   STANDS — an old branch checked out, or an uncommitted edit to build/, judges the push
#   with that checker: pull dev before pushing from an old branch — a checker from before
#   these gates is refused outright (it knows none of the arguments), never run. (6) Not
#   gated: a commit's signature headers (gpgsig, mergetag), the pushing identity GitHub
#   records on its side, and the lines GIT prints after this hook (the push url; on a
#   refused push git names the ref itself — the hook has refused by then, nothing was
#   published). (7) The private list is read from the MAIN checkout's config and the
#   environment, never from the pushed tree (a tracked config there is scanned, not read).
#
# The instance-data gate is THIS checkout's checker (build/check-instance-data.mjs and
# build/lib.mjs), staged ONCE per push in a temporary folder of its own OUTSIDE every
# worktree and pointed at each pushed tree with --root (F-589: a staging folder inside the
# pushed tree could be pre-planted by that tree — on a clone that checks symlinks out as
# symlinks, a tracked symlink at the staging path would have cp write through it and node
# run the tree's own module), so an older or weakened checker in the pushed tree never
# judges its own push, a tree that predates the gate is gated all the same, and the pushed
# tree's own copies of those two files are scanned like any other tracked file; the
# doc-drift and stale-facts gates on dev are the pushed tree's own, since they judge that
# tree's consistency. The checker finds the main checkout's private config through the
# common git dir (F-423) and inherits PRIVATE_INSTANCE_PATTERNS from this shell; when
# either exists, REQUIRE_PRIVATE_PATTERNS is set so a temporary-worktree run that somehow
# loads no private pattern is refused, not waved through with a warning.
#
# Git Bash converts an environment value that looks like a path when it starts a native
# program (node.exe): `https://acme\.gainsightcloud\.com` arrives as
# `https://acme/.gainsightcloud/.com`, a pattern that loads, is counted, and never matches
# (F-586). The hook excludes PRIVATE_INSTANCE_PATTERNS from that conversion for its own node
# runs; the hop from a Git Bash prompt into git.exe happens before any hook runs, so a Git
# Bash user sets MSYS2_ENV_CONV_EXCL=PRIVATE_INSTANCE_PATTERNS in that shell too (AGENTS.md
# § Data hygiene), or keeps the patterns in the config file.
# Skip everything with: git push --no-verify (say so on the bus).
#
# git exports GIT_DIR (and sometimes GIT_INDEX_FILE / GIT_WORK_TREE) to hooks; a git
# command run in the temporary worktree would then read THIS checkout's index. Clear them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
export MSYS2_ENV_CONV_EXCL="PRIVATE_INSTANCE_PATTERNS${MSYS2_ENV_CONV_EXCL:+;$MSYS2_ENV_CONV_EXCL}"
export GIT_NO_REPLACE_OBJECTS=1

ZERO=0000000000000000000000000000000000000000
REMOTE=$1
PUSH_URL=${2:-$1}
HOOK_ROOT=$(git rev-parse --show-toplevel) || exit 1
MAIN_ROOT=$(cd "$(git rev-parse --git-common-dir)/.." && pwd) || MAIN_ROOT=$HOOK_ROOT
if [ -f "$MAIN_ROOT/gs-admin-explorer.config.json" ] || [ -n "$PRIVATE_INSTANCE_PATTERNS" ]; then
  export REQUIRE_PRIVATE_PATTERNS=1
fi
NL='
'

# One temporary worktree at a time, and one staging folder for the whole push; both removed
# on every exit path, Ctrl-C included, so no checkout of a possibly leaking tree lingers
# under the temp folder or in .git/worktrees, and no copy of the checker either.
# An interrupted `worktree add` leaves the entry locked ("initializing"), which a single
# --force will not remove and prune skips: unlock first, force twice, then prune.
TMP_WT=
GATE_DIR=
cleanup() {
  [ -n "$TMP_WT" ] || return 0
  git worktree unlock "$TMP_WT" >/dev/null 2>&1
  git worktree remove --force --force "$TMP_WT" >/dev/null 2>&1 || rm -rf "$TMP_WT"
  git worktree prune >/dev/null 2>&1
  TMP_WT=
}
teardown() {
  cleanup
  [ -z "$GATE_DIR" ] || rm -rf "$GATE_DIR"
  GATE_DIR=
}
trap 'teardown; exit 130' INT TERM HUP QUIT
trap 'teardown' EXIT

# The checker, staged once, outside every worktree (F-589).
GATE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/gacd-prepush-gate-XXXXXX") || { echo "pre-push: could not create a temporary folder for the instance-data gate — push refused" >&2; exit 1; }
cp "$HOOK_ROOT/build/check-instance-data.mjs" "$HOOK_ROOT/build/lib.mjs" "$GATE_DIR/" || { echo "pre-push: could not stage this checkout's instance-data checker — push refused" >&2; exit 1; }
CHECKER=$GATE_DIR/check-instance-data.mjs
# A checker from before these gates (an old branch checked out: stated limit 5) knows none of the arguments below
# and would scan the wrong place under a misleading refusal — refused here by name, before anything is gated.
grep -q -- '--extra-private' "$CHECKER" || { echo "pre-push: the instance-data checker in this checkout ($HOOK_ROOT/build/check-instance-data.mjs) predates the hook's gates (no --extra-private) — pull dev into this branch, or push from a checkout on dev; push refused" >&2; exit 1; }
# The ref-name and tag-object runs: the checker over the extras alone, rooted at this checkout for its config.
# A refusal names both readings (a hit, or the checker unable to run); the checker's own lines say which.
gate_texts() {
  node "$CHECKER" --root "$HOOK_ROOT" --no-tree "$@" >/dev/null </dev/null
}

# load_remote_have: HAVE becomes the commits the receiving remote holds as branch or tag
# tips (annotated tags peeled), read from the remote itself, once per push. Returns
# non-zero — with the recovery on stderr — when that set cannot be established. git's
# stderr is never merged into a captured list (a trace or warning line would otherwise be
# read as a commit), so a failure names the command to re-run for the reason.
HAVE=
HAVE_LOADED=
load_remote_have() {
  [ -z "$HAVE_LOADED" ] || return 0
  if ! adv=$(git ls-remote --heads --tags "$PUSH_URL" 2>/dev/null </dev/null); then
    echo "pre-push: could not read the refs of $REMOTE at its push URL (to see why: git ls-remote --heads --tags \"\$(git remote get-url --push $REMOTE)\") — the commits this push would publish cannot be established, so the push is refused; check the connection and push again (or --no-verify and say so on the bus)" >&2
    return 1
  fi
  # "<sha> <ref>" per tip, an annotated tag replaced by its peeled target.
  pairs=$(printf '%s\n' "$adv" | awk 'NF==2 {
      ref=$2
      if (length(ref) > 3 && substr(ref, length(ref)-2) == "^{}") { peeled[substr(ref, 1, length(ref)-3)]=$1 } else { obj[ref]=$1 }
    } END { for (r in obj) print ((r in peeled) ? peeled[r] : obj[r]) " " r }' | sort)
  types=$(printf '%s\n' "$pairs" | cut -d' ' -f1 | sort -u | git cat-file --batch-check 2>/dev/null) || {
    echo "pre-push: could not look up the refs of $REMOTE in this clone (git cat-file --batch-check failed) — push refused (or --no-verify and say so on the bus)" >&2
    return 1
  }
  missing=$(printf '%s\n' "$types" | awk '$2=="missing" && $1!="" {print $1}')
  if [ -n "$missing" ]; then
    first=$(printf '%s\n' "$missing" | head -n 1)
    firstref=$(printf '%s\n' "$pairs" | awk -v s="$first" '$1==s {print $2; exit}')
    n=$(printf '%s\n' "$missing" | wc -l | tr -d ' ')
    echo "pre-push: $REMOTE holds $n branch or tag tip(s) this clone has not fetched (first: $firstref at $(printf '%.12s' "$first")), so the commits this push would publish cannot be established — git fetch --tags $REMOTE, then push again (a clone that fetches only some branches: git fetch $REMOTE <sha>; or --no-verify and say so on the bus)" >&2
    return 1
  fi
  HAVE=$(printf '%s\n' "$types" | awk '$2=="commit" {print $1}')
  HAVE_LOADED=1
  return 0
}

# gate_tree <sha> <label> <arm>: check out <sha> into a temporary worktree and run the
# gates there — <arm> "dev" runs the pushed tree's doc-drift and stale-facts gates and then
# the instance-data gate, anything else the instance-data gate alone — over the tree and,
# beside it, the commit's message and identities (F-588). Returns non-zero when a gate
# fails. Reads nothing from stdin (the ref list is on it).
gate_tree() {
  sha=$1; label=$2; arm=$3; rc=0
  echo "pre-push:   $sha $label" >&2
  TMP_WT=$(mktemp -d "${TMPDIR:-/tmp}/gacd-prepush-XXXXXX") || { echo "pre-push: could not create a temporary directory for the gate" >&2; return 1; }
  if ! err=$(git worktree add --detach "$TMP_WT" "$sha" 2>&1 >/dev/null); then
    echo "pre-push: could not check out $sha ($label) into a temporary worktree: $err" >&2
    cleanup
    return 1
  fi
  if [ "$arm" = dev ] && [ -f "$TMP_WT/build/check-doc-drift.mjs" ]; then
    node "$TMP_WT/build/check-doc-drift.mjs" >&2 </dev/null || { echo "pre-push: check-doc-drift failed on $label ($sha) — fix or push --no-verify" >&2; rc=1; }
    [ $rc -eq 0 ] && { node "$TMP_WT/build/check-stale-facts.mjs" >&2 </dev/null || { echo "pre-push: check-stale-facts failed on $label ($sha) — fix or push --no-verify" >&2; rc=1; }; }
  fi
  if [ $rc -eq 0 ]; then
    short=$(printf '%.12s' "$sha")
    message=$GATE_DIR/message-$sha.txt
    identities=$GATE_DIR/identities-$sha.txt
    if ! git log -1 --format=%B "$sha" >"$message" 2>/dev/null </dev/null || ! git log -1 --format='%an <%ae>%n%cn <%ce>' "$sha" >"$identities" 2>/dev/null </dev/null; then
      echo "pre-push: could not read the message and identities of $sha ($label) — nothing vouches for them, push refused" >&2
      cleanup
      return 1
    fi
    # The checker roots itself at the pushed tree (--root) from its own folder outside it, and scans the tree's
    # own build/ files like any other tracked file.
    node "$CHECKER" --root "$TMP_WT" --extra "commit $short message" "$message" --extra-private "commit $short identities" "$identities" >&2 </dev/null || { echo "pre-push: check-instance-data failed on $label ($sha) — redact, then push again (or --no-verify and say so on the bus)" >&2; rc=1; }
  fi
  cleanup
  return $rc
}

while read local_ref local_sha remote_ref remote_sha; do
  arm=other
  case "$remote_ref" in
    refs/heads/main)
      # The override lifts THIS guard only — the gates below still run for main's own
      # tree and every other ref in the same push (release-gate review of 0.37.0, F-435).
      if [ "$ALLOW_MAIN_PUSH" != "1" ]; then
        echo "pre-push: direct push to main blocked (dev-loop). PR from dev instead, or ALLOW_MAIN_PUSH=1." >&2
        exit 1
      fi;;
    refs/heads/dev) arm=dev;;
  esac
  # A deletion pushes no tree and publishes no name; nothing to gate.
  [ "$local_sha" = "$ZERO" ] && continue
  # The ref's NAME first (F-588), before any line of this hook prints it: a name carrying a string the patterns
  # match is refused with the name unprinted. The checker's pass line is not shown (nothing was scanned but the
  # name); its findings are, masked. The file is removed first and its write checked, so a failed write can never
  # leave the previous ref's name to be judged in this one's place.
  rm -f "$GATE_DIR/ref-name.txt"
  printf '%s\n%s\n' "$remote_ref" "$local_ref" >"$GATE_DIR/ref-name.txt" || { echo "pre-push: could not write the ref name for the gate — push refused" >&2; exit 1; }
  gate_texts --extra "ref name" "$GATE_DIR/ref-name.txt" || {
    echo "pre-push: the name of a pushed ref carries text the instance-data patterns match (a private hit is not printed; the checker's lines above say which check), or the checker could not run (no private pattern under REQUIRE_PRIVATE_PATTERNS, an invalid pattern) — rename the branch or tag, or fix the patterns, then push again (or --no-verify and say so on the bus)" >&2
    exit 1
  }
  tip=$(git rev-parse --verify -q "$local_sha^{commit}" </dev/null) || {
    echo "pre-push: $remote_ref ($local_sha) does not point at a commit, so there is no tree to gate — push refused (a tag of a blob or tree: --no-verify and say so on the bus)" >&2
    exit 1
  }
  # Every annotated tag OBJECT the ref carries (F-588), peeled one by one — a tag of a tag publishes the inner object
  # too: its body (the message and any signature, every check) and its header (the name stored in the object, the
  # tagger: the private patterns alone) — read from git's raw object, so a tag pushed by sha is covered as well.
  obj=$local_sha
  while [ "$(git cat-file -t "$obj" 2>/dev/null </dev/null)" = tag ]; do
    tagshort=$(printf '%.12s' "$obj")
    tagraw=$GATE_DIR/tag-$obj.txt
    rm -f "$tagraw" "$tagraw.header" "$tagraw.body"
    git cat-file tag "$obj" >"$tagraw" 2>/dev/null </dev/null || { echo "pre-push: could not read the tag object $tagshort of $remote_ref — push refused" >&2; exit 1; }
    sed -n '1,/^$/p' "$tagraw" >"$tagraw.header" || { echo "pre-push: could not split the tag object $tagshort of $remote_ref — push refused" >&2; exit 1; }
    sed '1,/^$/d' "$tagraw" >"$tagraw.body" || { echo "pre-push: could not split the tag object $tagshort of $remote_ref — push refused" >&2; exit 1; }
    gate_texts --extra "tag $tagshort body" "$tagraw.body" --extra-private "tag $tagshort header" "$tagraw.header" || {
      echo "pre-push: check-instance-data failed on the tag object $tagshort of $remote_ref: its message, its name or its tagger carries text the patterns match (the checker's lines above say which), or the checker could not run — re-tag (git tag -f -a) and push again (or --no-verify and say so on the bus)" >&2
      exit 1
    }
    obj=$(sed -n 's/^object //p' "$tagraw" | head -n 1)
    [ -n "$obj" ] || { echo "pre-push: the tag object $tagshort of $remote_ref names no object — push refused" >&2; exit 1; }
  done
  load_remote_have || exit 1
  # Every commit reachable from the tip that the remote holds under no branch or tag,
  # oldest first; then the tip itself, last, whether or not the remote already holds it.
  if [ -n "$HAVE" ]; then
    new=$( { printf '%s\n' "$tip"; printf '%s\n' "$HAVE" | sed 's/^/^/'; } | git rev-list --reverse --stdin 2>/dev/null ) || {
      echo "pre-push: could not establish the commits $remote_ref would publish (git rev-list failed) — git fetch --tags $REMOTE, then push again (or --no-verify and say so on the bus)" >&2
      exit 1
    }
  else
    new=$(git rev-list --reverse "$tip" 2>/dev/null </dev/null) || { echo "pre-push: could not list the commits of $remote_ref (git rev-list failed) — push refused" >&2; exit 1; }
  fi
  if printf '%s\n' "$new" | grep -qx "$tip"; then
    commits=$new
  else
    commits="${new:+$new$NL}$tip"
  fi
  count=$(printf '%s\n' "$commits" | wc -l | tr -d ' ')
  echo "pre-push: gating the $count pushed tree(s) of $remote_ref (F-423: every ref; F-584: the commits $REMOTE lacks, read from $REMOTE itself, tip last; F-588: each commit's message and identities beside its tree)..." >&2
  for c in $commits; do
    if [ "$c" = "$tip" ]; then
      gate_tree "$c" "$remote_ref (tip)" "$arm" </dev/null || exit 1
    else
      gate_tree "$c" "$remote_ref (pushed commit)" other </dev/null || exit 1
    fi
  done
done
exit 0
